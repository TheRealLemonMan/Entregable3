# Puerto HTTP del servidor Express
PORT=5000
# URI de MongoDB Atlas o de una instancia MongoDB accesible. Sustituir todos los marcadores.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>/<base_de_datos>?retryWrites=true&w=majority
# Origen(es) del frontend permitidos por CORS; separar varios con comas.
CLIENT_ORIGIN=http://localhost:5173,https://tu-frontend.onrender.com
